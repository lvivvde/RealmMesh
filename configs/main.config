-- 启动拓扑:login_verify(无依赖)与 realm → login → gateway(entry 入口)。
-- 模式 1(全拓扑一体)按此启动;模式 2(--service <name>)收窄为单服务。
return {
    services = {
        { name = "login_verify" },
        { name = "realm" },
        { name = "login", depends_on = { "realm" } },
        { name = "gateway", depends_on = { "login" }, entry = true },
    },
}
